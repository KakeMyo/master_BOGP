* text=auto

# Keep source files consistent across macOS, Windows, and Linux.
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.tex text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Research artifacts are binary files.
*.pdf binary
*.pptx binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
